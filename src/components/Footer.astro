---
import { COPYRIGHT_NAME, SOCIAL_LINKS } from "../consts";
import SocialIcon from "./SocialIcon.astro";
const year = new Date().getFullYear();
---

<footer transition:name="site-footer" transition:animate="none" class="mt-auto border-t border-border glass">
  <div class="bar-inner h-bar items-center justify-between gap-3">
    <p class="text-nav text-subtle">© {year} {COPYRIGHT_NAME} · 使用 Astro 构建</p>
    <ul class="flex items-center" aria-label="社交链接">
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a class="icon-button" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="sr-only">{link.label}</span>
            <SocialIcon icon={link.icon} size={18} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
