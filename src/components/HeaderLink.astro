---
import type { HTMLAttributes } from "astro/types";
import { isRouteActive, withBase } from "../utils/withBase";

type Props = HTMLAttributes<"a">;

const {
  href,
  class: className,
  ...props
} = Astro.props as Props;
const rawHref = typeof href === "string" ? href : "";
const isActive = rawHref.startsWith("/") && isRouteActive(Astro.url.pathname, rawHref);
const resolvedHref = typeof href === "string" ? withBase(href) : href;
---

<a
  href={resolvedHref}
  class:list={["no-underline", className]}
  aria-current={isActive ? "page" : undefined}
  {...props}
>
  <slot />
</a>
