<script>
  const copyText = async (text: string) => {
    if (!navigator.clipboard) throw new Error("Clipboard unavailable");
    await navigator.clipboard.writeText(text);
  };

  // 换页后重新处理代码块，data-code-block 防止重复包装。
  const initCodeCopy = () => {
    document.querySelectorAll<HTMLElement>(".prose pre").forEach((pre) => {
      if (pre.closest("[data-code-block]")) return;
      const code = pre.querySelector("code");
      if (!code) return;

      const wrapper = document.createElement("div");
      wrapper.className = "relative";
      wrapper.dataset.codeBlock = "";
      pre.before(wrapper);
      wrapper.append(pre);

      const button = document.createElement("button");
      button.className = "chip chip-link absolute top-2 right-2 bg-surface data-[state=success]:text-accent data-[state=error]:text-content";
      button.type = "button";
      button.textContent = "复制";
      button.setAttribute("aria-label", "复制代码");
      button.setAttribute("aria-live", "polite");
      wrapper.append(button);

      button.addEventListener("click", async () => {
        try {
          await copyText(code.textContent ?? "");
          button.textContent = "已复制";
          button.dataset.state = "success";
        } catch {
          button.textContent = "复制失败";
          button.dataset.state = "error";
        }
        window.setTimeout(() => { button.textContent = "复制"; button.dataset.state = ""; }, 1600);
      });
    });
  };

  const initCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>("button[data-copy-text]").forEach((button) => {
      if (button.dataset.copyReady === "true") return;
      button.dataset.copyReady = "true";
      const label = button.textContent ?? "复制";
      button.addEventListener("click", async () => {
        try {
          await copyText(button.dataset.copyText ?? "");
          button.textContent = "已复制";
          button.dataset.state = "success";
        } catch {
          button.textContent = "复制失败";
          button.dataset.state = "error";
        }
        window.setTimeout(() => { button.textContent = label; button.dataset.state = ""; }, 1600);
      });
    });
  };

  document.addEventListener("astro:page-load", initCodeCopy);
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
