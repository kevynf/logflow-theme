---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const classes = href ? "chip chip-link" : "chip";
---

{href ? (
  <a class:list={[classes, className]} href={href}><slot /></a>
) : (
  <span class:list={[classes, className]}><slot /></span>
)}
