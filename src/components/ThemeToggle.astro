<button
  data-theme-toggle
  type="button"
  aria-label="切换深浅色模式"
  aria-pressed="false"
  class="icon-button relative"
>
  <svg class="absolute size-4.5 fill-none stroke-current stroke-2 opacity-0 transition-opacity dark:opacity-100" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
  <svg class="absolute size-4.5 fill-none stroke-current stroke-2 opacity-100 transition-opacity dark:opacity-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path></svg>
</button>

<script>
  const initThemeToggle = () => {
    const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!button || button.dataset.ready === "true") return;
    button.dataset.ready = "true";
    const sync = () => button.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
    const persist = () => {
      try {
        localStorage.setItem("theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
      } catch {}
    };
    sync();
    button.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark");
      persist();
      sync();
    });
  };

  document.addEventListener("astro:page-load", initThemeToggle);
  document.addEventListener("astro:after-swap", () => {
    document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
  });
  initThemeToggle();
</script>
