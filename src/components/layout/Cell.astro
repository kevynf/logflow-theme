---
type CellTag = "div" | "section" | "header" | "article" | "li" | "a" | "h2";

export interface Props {
  as?: CellTag;
  variant?: "body" | "header";
  interactive?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = "div", variant = "body", interactive = false, class: className, ...attrs } = Astro.props;
---

<Tag
  class:list={[
    "min-w-0 px-cell-x py-cell-y",
    variant === "header" && "bg-surface-alt",
    interactive && "transition-colors hover:bg-surface-hover",
    className,
  ]}
  {...attrs}
>
  <slot />
</Tag>
