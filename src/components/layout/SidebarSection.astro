---
import Box from "./Box.astro";
import Cell from "./Cell.astro";

interface Props { title: string; href?: string }
const { title, href } = Astro.props;
---

<Box as="section">
  <Cell as="header" variant="header" class="flex items-baseline justify-between gap-3">
    <h2 class="text-section text-heading">
      {href ? <a class="text-heading no-underline hover:text-accent" href={href}>{title}</a> : title}
    </h2>
    <slot name="action" />
  </Cell>
  <Cell><slot /></Cell>
</Box>
