---
type BoxTag = "div" | "section" | "header" | "article" | "aside";

export interface Props {
  as?: BoxTag;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = "div", class: className, ...attrs } = Astro.props;
---

<Tag class:list={["min-w-0 divide-y divide-border overflow-hidden rounded-box border border-border glass", className]} {...attrs}>
  <slot />
</Tag>
