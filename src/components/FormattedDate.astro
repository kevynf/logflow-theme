---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"time">, "datetime"> & {
  date: Date;
};

const { date, ...props } = Astro.props;
const isThisYear = date.getFullYear() === new Date().getFullYear();
const text = isThisYear
  ? `${date.getMonth() + 1}月${date.getDate()}日`
  : `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`;
const fullText = date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---

<time datetime={date.toISOString()} title={fullText} {...props}>{text}</time>
