---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Cell from "./layout/Cell.astro";
import Badge from "./Badge.astro";
import Meta from "./Meta.astro";
import { estimateReadingMinutes, tagPath } from "../utils/content";
import { withBase } from "../utils/withBase";

interface Props {
  posts: CollectionEntry<"blog">[];
  showDescription?: boolean;
  showReadingTime?: boolean;
}

const { posts, showDescription = true, showReadingTime = false } = Astro.props;
---

<ul class="min-w-0 divide-y divide-border">
  {
    posts.map((post) => {
      const tags = post.data.tags ?? [];
      return (
        <Cell as="li">
          <article class="grid gap-1">
            <h2 class="text-card">
              <a class="text-heading no-underline hover:text-accent" href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
            </h2>
            {showDescription && <p class="text-body">{post.data.description}</p>}
            <footer class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              {tags.length > 0 && (
                <ul class="flex flex-wrap gap-1.5" aria-label="文章标签">
                  {tags.map((tag) => <li><Badge href={withBase(tagPath(tag))}>{tag}</Badge></li>)}
                </ul>
              )}
              <Meta class="ml-auto">
                <FormattedDate date={post.data.pubDate} />
                {showReadingTime && <span>{estimateReadingMinutes(post.body ?? "")} 分钟</span>}
              </Meta>
            </footer>
          </article>
        </Cell>
      );
    })
  }
</ul>
