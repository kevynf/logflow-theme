---
import { getCollection } from "astro:content";
import ArchiveLink from "../components/ArchiveLink.astro";
import Badge from "../components/Badge.astro";
import GitHubContribute from "../components/GitHubContribute.astro";
import PostList from "../components/PostList.astro";
import Box from "../components/layout/Box.astro";
import Cell from "../components/layout/Cell.astro";
import { HOME, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { sortByDateDesc } from "../utils/content";
import { withBase } from "../utils/withBase";

const posts = sortByDateDesc(await getCollection("blog")).slice(0, HOME.recentPostsLimit);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Box>
    <Cell variant="header" class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-3">
      <img class="size-18 rounded-box object-cover" src={withBase(HOME.avatar.src)} alt={HOME.avatar.alt} width="72" height="72" loading="eager" fetchpriority="high" />
      <div class="grid min-w-0 gap-1">
        <h1 class="text-title text-heading">{SITE_TITLE}</h1>
        <p class="text-body">{HOME.description}</p>
      </div>
    </Cell>
    <Cell class="flex items-baseline justify-between gap-3">
      <p class="min-w-0 text-body text-subtle">{HOME.motto}</p>
      <Badge href={withBase("/about/")}>关于本站</Badge>
    </Cell>
  </Box>
  <Box as="section">
    <Cell as="header" variant="header" class="flex items-baseline justify-between gap-3">
      <h2 class="text-section text-heading">最近文章</h2>
      <ArchiveLink />
    </Cell>
    <PostList posts={posts} showReadingTime={true} />
  </Box>
  <GitHubContribute />
</SiteLayout>
