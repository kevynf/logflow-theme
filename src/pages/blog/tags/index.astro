---
import { getCollection } from "astro:content";
import PageHeader from "../../../components/PageHeader.astro";
import Box from "../../../components/layout/Box.astro";
import Cell from "../../../components/layout/Cell.astro";
import { PAGE_COPY, SITE_TITLE } from "../../../consts";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getTagCounts, tagPath } from "../../../utils/content";
import { withBase } from "../../../utils/withBase";

const tags = getTagCounts(await getCollection("blog"));
---

<SiteLayout title={`${PAGE_COPY.tags.title} | ${SITE_TITLE}`} description={PAGE_COPY.tags.description}>
  <PageHeader title={PAGE_COPY.tags.title} description={PAGE_COPY.tags.description} descriptionItalic={PAGE_COPY.tags.descriptionItalic} count={{ value: tags.length, unit: "个" }} />
  <Box>
    <Cell>
      <ol class="columns-1 gap-6 sm:columns-2 md:columns-3">
        {tags.map(([tag, count], index) => (
          <li class="break-inside-avoid">
            <a class="grid grid-cols-[2ch_minmax(0,1fr)_auto] items-center gap-2 py-2 text-heading no-underline hover:text-accent" href={withBase(tagPath(tag))}>
              <span class="text-label tabular-nums text-subtle" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <strong class="min-w-0 truncate text-card font-bold">{tag}</strong>
              <small class="text-label whitespace-nowrap text-subtle">{count} 篇</small>
            </a>
          </li>
        ))}
      </ol>
    </Cell>
  </Box>
</SiteLayout>
