---
import { getCollection } from "astro:content";
import ArchiveLink from "../../components/ArchiveLink.astro";
import Count from "../../components/Count.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import Box from "../../components/layout/Box.astro";
import SidebarSection from "../../components/layout/SidebarSection.astro";
import { PAGE_COPY, SITE_TITLE } from "../../consts";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { collectionPath, getCollectionSummaries, getTagCounts, sortByDateDesc, tagPath } from "../../utils/content";
import { withBase } from "../../utils/withBase";

const posts = sortByDateDesc(await getCollection("blog"));
const collections = getCollectionSummaries(posts);
const tags = getTagCounts(posts);
---

<SiteLayout title={`${PAGE_COPY.blog.title} | ${SITE_TITLE}`} description={PAGE_COPY.blog.description}>
  <PageHeader title={PAGE_COPY.blog.title} description={PAGE_COPY.blog.description} descriptionItalic={PAGE_COPY.blog.descriptionItalic} count={{ value: posts.length, unit: "篇" }}>
    <ArchiveLink slot="description-action" />
  </PageHeader>
  <div class="grid items-start gap-box md:grid-cols-[minmax(0,3fr)_minmax(160px,.85fr)]">
    <Box><PostList posts={posts} showReadingTime={true} /></Box>
    <aside class="grid gap-box">
      <SidebarSection title="专题" href={withBase("/blog/collections/")}>
        <ul class="grid gap-2">
          {collections.map(([name, meta]) => (
            <li>
              <a class="flex items-center justify-between gap-2 text-content no-underline hover:text-accent" href={withBase(collectionPath(name))}>
                {name}<Count value={meta.count} unit="篇" />
              </a>
            </li>
          ))}
        </ul>
      </SidebarSection>
      <SidebarSection title="标签" href={withBase("/blog/tags/")}>
        <ul class="flex flex-wrap gap-1.5">
          {tags.map(([tag, count]) => (
            <li>
              <a class="chip chip-link" href={withBase(tagPath(tag))}>
                {tag}<span class="tabular-nums">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </SidebarSection>
    </aside>
  </div>
</SiteLayout>
