---
import { getCollection } from "astro:content";
import PageHeader from "../../../components/PageHeader.astro";
import Count from "../../../components/Count.astro";
import Box from "../../../components/layout/Box.astro";
import Cell from "../../../components/layout/Cell.astro";
import { PAGE_COPY, SITE_TITLE } from "../../../consts";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { collectionPath, getCollectionSummaries } from "../../../utils/content";
import { withBase } from "../../../utils/withBase";

const items = getCollectionSummaries(await getCollection("blog"));
---

<SiteLayout title={`${PAGE_COPY.collections.title} | ${SITE_TITLE}`} description={PAGE_COPY.collections.description}>
  <PageHeader title={PAGE_COPY.collections.title} description={PAGE_COPY.collections.description} descriptionItalic={PAGE_COPY.collections.descriptionItalic} count={{ value: items.length, unit: "个" }} />
  <Box>
    <ul class="divide-y divide-border">
      {items.map(([name, meta]) => (
        <li>
          <Cell as="a" interactive class="group block no-underline" href={withBase(collectionPath(name))}>
            <span class="flex items-center justify-between gap-3">
              <strong class="min-w-0 text-card text-heading group-hover:text-accent">{name}</strong>
              <Count value={meta.count} unit="篇" />
            </span>
            {meta.description && <span class="mt-1 block truncate text-body text-content">{meta.description}</span>}
          </Cell>
        </li>
      ))}
    </ul>
  </Box>
</SiteLayout>
