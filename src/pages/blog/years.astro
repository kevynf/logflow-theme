---
import { getCollection } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import Count from "../../components/Count.astro";
import PostList from "../../components/PostList.astro";
import Box from "../../components/layout/Box.astro";
import Cell from "../../components/layout/Cell.astro";
import { PAGE_COPY, SITE_TITLE } from "../../consts";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { sortByDateDesc } from "../../utils/content";

const posts = sortByDateDesc(await getCollection("blog"));
const postsByYear = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
const groups = Array.from(postsByYear.entries()).sort((a, b) => b[0] - a[0]);
---

<SiteLayout title={`${PAGE_COPY.years.title} | ${SITE_TITLE}`} description={PAGE_COPY.years.description}>
  <PageHeader title={PAGE_COPY.years.title} description={PAGE_COPY.years.description} descriptionItalic={PAGE_COPY.years.descriptionItalic} count={{ value: posts.length, unit: "篇" }} />
  {groups.map(([year, items]) => (
    <Box as="section">
      <Cell as="header" variant="header" class="flex items-center gap-2">
        <h2 class="text-section text-heading">{year}</h2>
        <Count value={items.length} unit="篇" />
      </Cell>
      <PostList posts={items} showDescription={false} />
    </Box>
  ))}
</SiteLayout>
