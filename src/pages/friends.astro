---
import CommentSection from "../components/CommentSection.astro";
import PageHeader from "../components/PageHeader.astro";
import Box from "../components/layout/Box.astro";
import Cell from "../components/layout/Cell.astro";
import { FRIEND_LINKS, HOME, PAGE_COPY, SITE_TITLE } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../utils/withBase";

const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, "");
const avatarUrl = new URL(withBase(HOME.avatar.src), Astro.site).href;
const ownFriendLinkText = `Name: ${SITE_TITLE}\nDesc: ${HOME.motto}\nLink: ${siteUrl}\nAvatar: ${avatarUrl}`;
---

<SiteLayout title={`${PAGE_COPY.friends.title} | ${SITE_TITLE}`} description={PAGE_COPY.friends.description}>
  <PageHeader title={PAGE_COPY.friends.title} description={PAGE_COPY.friends.description} descriptionItalic={PAGE_COPY.friends.descriptionItalic} count={{ value: FRIEND_LINKS.length, unit: "位" }} />
  <Box>
    <ul class="grid gap-0 sm:grid-cols-2">
      {FRIEND_LINKS.map((link) => (
        <li>
          <Cell as="a" interactive class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3 no-underline" href={link.link ?? link.url} target="_blank" rel="noopener noreferrer">
            {link.avatar
              ? <img class="size-10 rounded-box object-cover" src={link.avatar} alt="" width="40" height="40" loading="lazy" />
              : <span class="grid size-10 place-items-center rounded-box bg-surface-alt text-heading" aria-hidden="true">{link.name.slice(0, 1)}</span>}
            <span class="min-w-0">
              <strong class="block text-card text-heading">{link.name}</strong>
              <small class="mt-0.5 block text-body text-content">{link.desc ?? link.description}</small>
            </span>
          </Cell>
        </li>
      ))}
    </ul>
  </Box>
  <Box as="section">
    <Cell as="header" variant="header" class="flex items-center justify-between gap-3">
      <h2 class="text-section text-heading">交换友链</h2>
      <button class="chip chip-link data-[state=success]:text-accent data-[state=error]:text-content" type="button" data-copy-text={ownFriendLinkText} aria-live="polite">复制</button>
    </Cell>
    <Cell>
      <pre class="m-0 overflow-x-auto rounded-box bg-surface-alt px-cell-x py-cell-y text-code"><code>{ownFriendLinkText}</code></pre>
    </Cell>
  </Box>
  <CommentSection />
</SiteLayout>
