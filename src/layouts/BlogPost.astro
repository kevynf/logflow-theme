---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "../components/Badge.astro";
import CommentSection from "../components/CommentSection.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Meta from "../components/Meta.astro";
import Prose from "../components/Prose.astro";
import Box from "../components/layout/Box.astro";
import Cell from "../components/layout/Cell.astro";
import { collectionPath, estimateReadingMinutes, tagPath } from "../utils/content";
import { withBase } from "../utils/withBase";
import SiteLayout from "./SiteLayout.astro";

type BlogPostData = CollectionEntry<"blog">["data"];
interface Props extends BlogPostData { body?: string; enableComments?: boolean }
const { title, description, pubDate, updatedDate, heroImage, collection, tags = [], body = "", enableComments = false } = Astro.props;
---

<SiteLayout title={title} description={description} image={heroImage} type="article">
  <Box as="header">
    <Cell variant="header">
      <nav aria-label="面包屑">
        <ol class="flex flex-wrap items-center gap-x-2 text-label text-subtle">
          <li><a class="no-underline hover:text-accent" href={withBase("/blog/")}>文章</a></li>
          {collection && (
            <li class="flex items-center gap-x-2">
              <span aria-hidden="true">/</span>
              <a class="no-underline hover:text-accent" href={withBase(collectionPath(collection))}>{collection}</a>
            </li>
          )}
        </ol>
      </nav>
      <h1 class="mt-1 min-w-0 text-title text-heading">{title}</h1>
      <p class="mt-1 text-body">{description}</p>
    </Cell>
    <Cell class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label="文章标签">
          {tags.map((tag) => <li><Badge href={withBase(tagPath(tag))}>{tag}</Badge></li>)}
        </ul>
      )}
      <Meta class="ml-auto">
        <FormattedDate date={pubDate} />
        {updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
        <span>{estimateReadingMinutes(body)} 分钟</span>
      </Meta>
    </Cell>
  </Box>
  {heroImage && (
    <Box>
      <Image class="w-full" width={840} height={420} src={heroImage} alt={title} />
    </Box>
  )}
  <Prose>
    <slot />
  </Prose>
  {enableComments && <CommentSection />}
</SiteLayout>
